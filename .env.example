# 집핀(Jippin) — 환경변수 예시 파일 (레포 공통 인덱스)
# AGENTS.md §4.4 / CEO 브리프 §5.1 봉인.
#
# 사용법:
#   cp .env.example .env
#   각 값을 실제 자격증명/URL로 채운다.
#
# 절대 금지:
#   - 본 파일에는 **실제 값**을 절대 적지 않는다. (예시값/형식만)
#   - 실제 `.env`는 `.gitignore` 가 차단한다.
#
# 정본 위치: 앱별 상세 변수는 각 앱의 .env.example 이 정본이다.
#   - apps/api/.env.example      : 백엔드 전체 (DB·인증·우리집 체크·에이전트·SMS 등)
#   - apps/web/.env.example      : 프론트 (NEXT_PUBLIC_* · S3 프리사인 · JUSO 팝업)
#   - apps/admin/.env.example    : 관리자 콘솔
#   - infra/compose/.env.example : 로컬 docker compose 주입분
# 본 파일은 공통으로 자주 쓰는 키만 인덱스로 둔다.
#
# 시크릿 매니저 사용 권장 (운영). 로컬은 .env, CI/CD는 GitHub Actions Secrets.

# =============================================================================
# 1. 공통 — 런타임 모드
# =============================================================================
# 값: development | test | staging | production (config.py::ALLOWED_APP_ENVS 봉인)
APP_ENV=development
# 값: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# request_id 미들웨어 헤더명 (AGENTS.md §4.5)
REQUEST_ID_HEADER=x-request-id

# =============================================================================
# 2. Supabase Postgres (AGENTS.md §4.4 / ADR-0004)
# - DATABASE_URL      : non-pooler(직결 5432). 마이그레이션·롱 트랜잭션·에이전트 체크포인터.
# - DATABASE_POOL_URL : pooler(6543).          FastAPI 일반 쿼리.
# - 비밀번호는 평문 커밋 금지. 운영은 시크릿 매니저.
# - APP_ENV ↔ Supabase branch 매핑은 환경별 URL 값으로만 한다.
#   자세한 매핑: docs/runbooks/supabase-branching.md.
# =============================================================================
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_POOL_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# =============================================================================
# 3. Redis 7.4 (ADR-0001 §5)
# - 휴대폰 OTP · OAuth state · CODEF 토큰 캐시가 공유한다.
# - REDIS_MAX_MEMORY / REDIS_EVICTION_POLICY 는 compose 참고값.
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_MAX_MEMORY=256mb
REDIS_EVICTION_POLICY=allkeys-lru

# =============================================================================
# 4. 객체 스토리지 — Supabase Storage (ADR-0007/0008)
# - 실사용 버킷: lead-floorplans · session-floorplans · session-reports · home-check-docs.
# - 버킷명 변수와 service_role 키는 apps/api/.env.example 이 정본.
# - 프론트 프리사인(S3_*)은 apps/web/.env.example 참조.
# - (구 Cloudflare R2 블록은 제거됨 — 코드 미사용, ADR-0001 §6 잔존 표기.)
# =============================================================================

# =============================================================================
# 5. OAuth — 소셜 로그인 (정본: Supabase Auth — ADR-0004)
# - Google/Kakao provider 시크릿은 Supabase 콘솔이 단독 보유한다.
# - 아래 자체 OAuth 변수는 legacy 경로 + Naver Custom OAuth PoC fallback 잔존분
#   (ADR-0004 §2.5). 상세·해설은 apps/api/.env.example AUTH 절이 정본.
# =============================================================================
KAKAO_REST_API_KEY=REPLACE_ME
KAKAO_CLIENT_SECRET=REPLACE_ME
KAKAO_REDIRECT_URI=http://localhost:8000/auth/callback/kakao

GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback/google

NAVER_OAUTH_CLIENT_ID=REPLACE_ME
NAVER_OAUTH_CLIENT_SECRET=REPLACE_ME
NAVER_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback/naver

OAUTH_STATE_REDIS_URL=redis://redis:6379/1
# 정식 키. legacy 명칭 OAUTH_STATE_TTL_SECONDS 도 alias 로 인식되나 둘 다 정의하지 말 것.
AUTH_OAUTH_STATE_TTL_SECONDS=600

FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/auth/success
FRONTEND_AUTH_FAILURE_URL=http://localhost:3000/auth/failure
FRONTEND_AUTH_TERMS_URL=http://localhost:3000/auth/terms

# =============================================================================
# 6. 백엔드 세션 쿠키 JWT (AGENTS.md §4.4)
# - 256bit 이상 random secret. openssl rand -base64 48
# - (구 AUTH_JWT_ACCESS/REFRESH_TTL_SECONDS 는 Supabase Auth cutover 로 폐기.)
# =============================================================================
AUTH_JWT_SECRET=REPLACE_ME_WITH_RANDOM_256BIT_SECRET
AUTH_JWT_ALG=HS256
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_NAME=jippin_session
# 운영 도메인에서만 설정. 로컬은 비움.
AUTH_COOKIE_DOMAIN=
# 비움이면 APP_ENV=production 에서만 Secure=true.
AUTH_COOKIE_SECURE=
KAKAO_SYNC_REQUIRED_TERM_TAGS=service_terms,privacy_policy

# =============================================================================
# 7. AI — OpenAI (에이전트/VLM) + HuggingFace 세그멘테이션
# - 모델·플래그·타임아웃 등 상세는 apps/api/.env.example (AGENT_* / VLM_* / HF_*).
# - 에이전트 모델 기본값은 AGENT_MODEL=openai:gpt-5.6-luna, 도면 VLM 은 별도
#   VLM_MODEL=openai:gpt-5.6-luna (2026-08-19 분리 — 지금은 같은 모델, 독립 조정 가능).
# =============================================================================
OPENAI_API_KEY=sk-REPLACE_ME
HF_SEGMENTATION_ENDPOINT_URL=
HF_SEGMENTATION_TOKEN=

# =============================================================================
# 8. 프론트엔드 — 공개 변수 (NEXT_PUBLIC_*)
# - 브라우저로 노출되는 값만. 시크릿 금지. 정본: apps/web/.env.example.
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-publishable-key>
SUPABASE_FLOW_COOKIE_SECRET=REPLACE_ME_WITH_RANDOM_FLOW_COOKIE_SECRET
# legacy — api 현행 코드가 읽지 않는다(HS256 폴백 미구현, bearer 검증은 JWKS 전용).
SUPABASE_JWT_SECRET=REPLACE_ME_WITH_SUPABASE_JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated
# (구 NEXT_PUBLIC_APP_NAME / NEXT_PUBLIC_LEGAL_NOTICE_VERSION 은 코드 미사용으로 제거됨.)
